# Copy to backend/.env and fill in what you have. Everything is optional:
# the app degrades to a local file memory and template generation without keys.

# --- Hindsight (required for the hackathon: memory layer) ---
# Hindsight Cloud:
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hs_xxx
# Or local OSS server:
# HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=social-engagement-agent
HINDSIGHT_TAG=demo

# --- LLM (optional; omit to use deterministic template fallback) ---
# Groq (fast free tier):
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=openai/gpt-oss-120b
# Or OpenAI:
# OPENAI_API_KEY=sk_xxx
# OPENAI_MODEL=gpt-4o-mini

# --- Misc ---
PORT=4000
